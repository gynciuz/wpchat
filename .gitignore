# dependencies
node_modules/
.pnpm-store/

# build outputs
# NOTE: /build is committed (it's what ships in the WP plugin ZIP).
#       /app/dist is the per-app intermediate build dir if any.
app/dist/
*.tsbuildinfo

# Packaged release ZIPs (bin/release.sh) — these are uploaded to GitHub
# Releases as assets, not committed to the repo.
/chat-admin-v*.zip

# editor / OS
.DS_Store
.vscode/
.idea/

# env / secrets
.env*
!.env.example

# PHP — only the root Composer install dir. NOT a bare `vendor/`, which also
# matches vendor-puc/plugin-update-checker/vendor/ (bundled Parsedown etc.) and
# kept it out of git → the release ZIP shipped without Parsedown, fataling the
# PUC GitHub update check ("Class Parsedown not found") on wp-admin/plugins.php.
/vendor/
composer.lock

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache

# pnpm
pnpm-debug.log*
/dist/
